# GridGuide backend environment variables.
# The real values live in Vercel (project "gridguide"). Get them locally with:
#   vercel env pull .env.local
# Never commit .env.local or any real value.

# Shared secret that eGain sends in the x-api-key header on every agent call.
# Production: required (the API answers 503 "misconfigured" without it).
# Local: optional (requests are allowed when it is unset).
GRIDGUIDE_API_KEY=

# Upstash Redis REST credentials, added by the Vercel Marketplace integration.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as well.
# Without them the API falls back to an in-memory store (data resets on restart).
# Preview and local runs share the database but write under their own key prefix,
# so they never touch the live console's data.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set automatically by Vercel ("production", "preview" or "development"); leave it unset locally.
# VERCEL_ENV=
